# University Policy RAG - Environment Configuration
# Copy this to .env and adjust variables as needed.

# Storage paths
# DATA_DIR=./data
# VECTORSTORE_DIR=./vectorstore
# EVAL_DIR=./eval

# LLM & Embedding models
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Document chunking
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# Retrieval & reranking
# TOP_K_RETRIEVE=30
# TOP_K_FINAL=6
# BM25_K=15
# VECTOR_K=15
